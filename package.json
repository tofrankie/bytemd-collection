{
  "name": "bytemd-collection",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/tofrankie/bytemd-collection",
  "keywords": [
    "bytemd",
    "plugin"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "run-s lint:* typecheck",
    "lint:eslint": "eslint . --cache --fix",
    "lint:prettier": "prettier . --cache --write --log-level silent",
    "publint": "pnpm -r --if-present publint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "github:release": "tfr"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.7.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/svelte": "5.4.2",
    "@tofrankie/action": "^0.0.9",
    "@tofrankie/eslint": "^0.5.0",
    "@tofrankie/prettier": "^0.2.0",
    "@tofrankie/tsconfig": "^0.2.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "sass": "^1.102.0",
    "svelte": "5.56.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
