{
  "name": "bytemd-plugin-highlight-github",
  "type": "module",
  "version": "0.0.8",
  "packageManager": "pnpm@10.33.4",
  "description": "A bytemd plugin for syntax highlighting with bundled theme styles",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/tofrankie"
    },
    {
      "type": "ifdian",
      "url": "https://ifdian.net/a/tofrankie"
    }
  ],
  "homepage": "https://github.com/tofrankie/bytemd-collection/tree/main/packages/plugin-highlight-github",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/bytemd-collection.git",
    "directory": "packages/plugin-highlight-github"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/bytemd-collection/issues"
  },
  "keywords": [
    "bytemd",
    "plugin",
    "highlight",
    "highlight.js",
    "syntax"
  ],
  "sideEffects": [
    "*.css",
    "dist/styles/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/*.css": "./dist/styles/*.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles/light.css",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "run-s build:bundle build:styles",
    "build:bundle": "tsdown",
    "build:styles": "node ./scripts/build-highlight-styles.js",
    "prepublishOnly": "run-s typecheck build",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "peerDependencies": {
    "bytemd": "^1.5.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@primer/primitives": "^11.9.0",
    "bytemd": "^1.22.0",
    "sass": "^1.102.0"
  }
}
