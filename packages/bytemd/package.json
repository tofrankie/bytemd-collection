{
  "name": "@tofrankie/bytemd",
  "type": "module",
  "version": "1.22.0",
  "packageManager": "pnpm@10.33.4",
  "description": "A hackable Markdown editor and viewer for Svelte",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/tofrankie"
    },
    {
      "type": "ifdian",
      "url": "https://ifdian.net/a/tofrankie"
    }
  ],
  "homepage": "https://github.com/tofrankie/bytemd-collection/tree/main/packages/bytemd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/bytemd-collection.git",
    "directory": "packages/bytemd"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/bytemd-collection/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "viewer"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./locales/*": "./locales/*",
    "./lib/locales/*": "./locales/*",
    "./dist/index.css": "./dist/index.css"
  },
  "main": "./dist/index.js",
  "svelte": "./src/index.ts",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "locales",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "run-s clean build:js build:css",
    "build:js": "tsdown",
    "build:css": "node ./scripts/build-css.mjs",
    "clean": "node ./scripts/clean.mjs",
    "prepublishOnly": "run-s typecheck test build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "publint": "publint"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@popperjs/core": "^2.11.7",
    "@types/hast": "^2.3.4",
    "@types/lodash-es": "^4.17.7",
    "@types/mdast": "^3.0.11",
    "hast-util-sanitize": "^4.1.0",
    "lodash-es": "^4.17.21",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "select-files": "^1.0.1",
    "tippy.js": "^6.3.7",
    "unified": "^10.1.2",
    "unist-util-visit": "^4.1.2",
    "vfile": "^5.3.7",
    "word-count": "^0.2.2"
  },
  "devDependencies": {
    "@primer/css": "catalog:prod"
  }
}
