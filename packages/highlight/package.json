{
  "name": "@tofrankie/bytemd-plugin-highlight",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.4",
  "description": "ByteMD plugin to highlight code blocks",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/tofrankie/bytemd-plugin/tree/main/packages/highlight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/bytemd-plugin.git",
    "directory": "packages/highlight"
  },
  "keywords": [
    "bytemd",
    "plugin",
    "highlight",
    "highlight.js",
    "syntax"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./scss/*": "./scss/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "scss",
    "styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "run-s copy:styles build:bundle",
    "build:bundle": "tsdown",
    "copy:styles": "node ./scripts/copy-highlight-styles.js",
    "prepublishOnly": "run-s typecheck build",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "peerDependencies": {
    "bytemd": "^1.5.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "bytemd": "^1.22.0"
  }
}
